// Purchase: suppliers, purchase bills (stock IN), supplier payments, purchase returns (stock OUT).
// Documents are never edited or deleted after saving — they are cancelled (stock / money reversed).

enum DocStatus {
  POSTED
  CANCELLED

  @@map("doc_status")
}

/// CGST+SGST when the supplier is in our state, IGST otherwise.
enum TaxMode {
  INTRA
  INTER

  @@map("tax_mode")
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK
  CHEQUE

  @@map("payment_mode")
}

model Supplier {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(20) // S0001
  name           String   @db.VarChar(120)
  contactPerson  String?  @map("contact_person") @db.VarChar(80)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(120)
  gstin          String?  @unique @db.VarChar(15)
  stateCode      String   @default("32") @map("state_code") @db.VarChar(2)
  address        String?  @db.VarChar(255)
  city           String?  @db.VarChar(60)
  pincode        String?  @db.VarChar(6)
  /// Amount we already owed this supplier on the go-live date (+ = we owe them).
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  notes          String?  @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  purchases PurchaseInvoice[]
  payments  SupplierPayment[]
  returns   PurchaseReturn[]

  @@index([name])
  @@map("suppliers")
}

/// Purchase bill (PUR/2026-27/0001) — the supplier's invoice entered into our books.
model PurchaseInvoice {
  id                  Int                 @id @default(autoincrement())
  docNo               String              @unique @map("doc_no") @db.VarChar(30)
  supplierId          Int                 @map("supplier_id")
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierInvoiceNo   String              @map("supplier_invoice_no") @db.VarChar(40)
  supplierInvoiceDate DateTime            @map("supplier_invoice_date") @db.Date
  docDate             DateTime            @map("doc_date") @db.Date // goods received
  status              DocStatus           @default(POSTED)
  taxMode             TaxMode             @map("tax_mode")
  taxableTotal        Decimal             @map("taxable_total") @db.Decimal(14, 2)
  cgstTotal           Decimal             @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal           Decimal             @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal           Decimal             @default(0) @map("igst_total") @db.Decimal(14, 2)
  otherCharges        Decimal             @default(0) @map("other_charges") @db.Decimal(14, 2) // freight, packing …
  /// Cash / bill discount on the whole bill (before GST), spread over the items. Pct kept for display.
  billDiscount        Decimal             @default(0) @map("bill_discount") @db.Decimal(14, 2)
  billDiscountPct     Decimal             @default(0) @map("bill_discount_pct") @db.Decimal(5, 2)
  /// GST the supplier added on other charges (packing / forwarding). Included in the GST totals.
  chargesGstRate      Decimal             @default(0) @map("charges_gst_rate") @db.Decimal(5, 2)
  chargesTax          Decimal             @default(0) @map("charges_tax") @db.Decimal(14, 2)
  /// Freight paid separately to the transporter ("To pay"): goes into the items' cost, NOT owed to this supplier.
  freightSeparate     Decimal             @default(0) @map("freight_separate") @db.Decimal(14, 2)
  freightNote         String?             @map("freight_note") @db.VarChar(120)
  freightMode         PaymentMode?        @map("freight_mode") // how the transporter was paid (null = not paid yet)
  freightPaidOn       DateTime?           @map("freight_paid_on") @db.Date
  freightPaidAt       DateTime?           @map("freight_paid_at") // when it was entered (day book time)
  roundOff            Decimal             @default(0) @map("round_off") @db.Decimal(6, 2)
  grandTotal          Decimal             @map("grand_total") @db.Decimal(14, 2)
  paidAmount          Decimal             @default(0) @map("paid_amount") @db.Decimal(14, 2) // from payment allocations
  returnedAmount      Decimal             @default(0) @map("returned_amount") @db.Decimal(14, 2) // from purchase returns
  notes               String?             @db.VarChar(500)
  lines               PurchaseLine[]
  allocations         PaymentAllocation[]
  returns             PurchaseReturn[]
  createdBy           String              @map("created_by") @db.VarChar(50)
  createdAt           DateTime            @default(now()) @map("created_at")
  cancelledBy         String?             @map("cancelled_by") @db.VarChar(50)
  cancelledAt         DateTime?           @map("cancelled_at")
  cancelReason        String?             @map("cancel_reason") @db.VarChar(255)

  @@unique([supplierId, supplierInvoiceNo]) // same supplier bill can't be entered twice
  @@index([docDate])
  @@index([status])
  @@map("purchase_invoices")
}

model PurchaseLine {
  id          Int             @id @default(autoincrement())
  invoiceId   Int             @map("invoice_id")
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  variantId   Int             @map("variant_id")
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  qty         Decimal         @db.Decimal(14, 3)
  rate        Decimal         @db.Decimal(12, 2) // per unit, before discount and GST
  discountPct Decimal         @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxable     Decimal         @db.Decimal(14, 2)
  gstRate     Decimal         @map("gst_rate") @db.Decimal(5, 2)
  cgst        Decimal         @default(0) @db.Decimal(14, 2)
  sgst        Decimal         @default(0) @db.Decimal(14, 2)
  igst        Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(14, 2)
  /// Stock cost per unit = taxable + share of other charges (+ GST if we can't claim input credit).
  unitCost    Decimal         @map("unit_cost") @db.Decimal(14, 4)
  returnedQty Decimal         @default(0) @map("returned_qty") @db.Decimal(14, 3)

  @@index([invoiceId])
  @@index([variantId])
  @@map("purchase_lines")
}

/// Money paid to a supplier (PAY/2026-27/0001), allocated to bills; any remainder is an advance.
model SupplierPayment {
  id           Int                 @id @default(autoincrement())
  docNo        String              @unique @map("doc_no") @db.VarChar(30)
  supplierId   Int                 @map("supplier_id")
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  docDate      DateTime            @map("doc_date") @db.Date
  amount       Decimal             @db.Decimal(14, 2)
  mode         PaymentMode
  reference    String?             @db.VarChar(60) // UPI ref, cheque no …
  notes        String?             @db.VarChar(255)
  status       DocStatus           @default(POSTED)
  allocations  PaymentAllocation[]
  createdBy    String              @map("created_by") @db.VarChar(50)
  createdAt    DateTime            @default(now()) @map("created_at")
  cancelledBy  String?             @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?           @map("cancelled_at")
  cancelReason String?             @map("cancel_reason") @db.VarChar(255)

  @@index([supplierId, docDate])
  @@map("supplier_payments")
}

model PaymentAllocation {
  id        Int             @id @default(autoincrement())
  paymentId Int             @map("payment_id")
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId Int             @map("invoice_id")
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(14, 2)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// Goods sent back to the supplier (debit note DN/2026-27/0001) — stock OUT at the original cost.
model PurchaseReturn {
  id           Int                  @id @default(autoincrement())
  docNo        String               @unique @map("doc_no") @db.VarChar(30)
  supplierId   Int                  @map("supplier_id")
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceId    Int                  @map("invoice_id")
  invoice      PurchaseInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  docDate      DateTime             @map("doc_date") @db.Date
  reason       String               @db.VarChar(255)
  taxableTotal Decimal              @map("taxable_total") @db.Decimal(14, 2)
  taxTotal     Decimal              @map("tax_total") @db.Decimal(14, 2)
  grandTotal   Decimal              @map("grand_total") @db.Decimal(14, 2)
  status       DocStatus            @default(POSTED)
  lines        PurchaseReturnLine[]
  createdBy    String               @map("created_by") @db.VarChar(50)
  createdAt    DateTime             @default(now()) @map("created_at")
  cancelledBy  String?              @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?            @map("cancelled_at")
  cancelReason String?              @map("cancel_reason") @db.VarChar(255)

  @@index([supplierId, docDate])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id             Int            @id @default(autoincrement())
  returnId       Int            @map("return_id")
  return         PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  purchaseLineId Int            @map("purchase_line_id")
  variantId      Int            @map("variant_id")
  qty            Decimal        @db.Decimal(14, 3)
  taxable        Decimal        @db.Decimal(14, 2)
  tax            Decimal        @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  unitCost       Decimal        @map("unit_cost") @db.Decimal(14, 4)

  @@index([returnId])
  @@map("purchase_return_lines")
}
