// Training institute (Module 11): courses, batches, students, enrolments and fee receipts (FEE/2026-27/0001).
// No attendance (owner's choice, like staff). Teachers are staff members (paid through Staff & salary).
// Fees: no GST here (ask the accountant if the institute must charge GST). Receipts show in the day book
// and as "Training fees" income in profit & loss.

model Course {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100) // Basic tailoring, Fashion designing …
  months      Int      @default(3) // duration
  fee         Decimal  @db.Decimal(12, 2) // standard course fee
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  batches     Batch[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("courses")
}

model Batch {
  id         Int         @id @default(autoincrement())
  courseId   Int         @map("course_id")
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name       String      @db.VarChar(100) // "Morning · Oct 2026"
  timing     String?     @db.VarChar(60) // "10 AM – 12 PM, Mon–Fri"
  startDate  DateTime    @map("start_date") @db.Date
  teacherId  Int?        @map("teacher_id")
  teacher    Staff?      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  isActive   Boolean     @default(true) @map("is_active") // false = batch finished
  notes      String?     @db.VarChar(500)
  enrolments Enrolment[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([courseId])
  @@map("batches")
}

model Student {
  id            Int         @id @default(autoincrement())
  code          String      @unique @db.VarChar(20) // ST0001
  name          String      @db.VarChar(120)
  phone         String?     @db.VarChar(20)
  guardianPhone String?     @map("guardian_phone") @db.VarChar(20)
  address       String?     @db.VarChar(255)
  notes         String?     @db.VarChar(500)
  enrolments    Enrolment[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([name])
  @@index([phone])
  @@map("students")
}

enum EnrolmentStatus {
  STUDYING
  COMPLETED
  DROPPED // left — remaining fee is no longer expected

  @@map("enrolment_status")
}

/// A student joining a batch, with the fee agreed for that course.
model Enrolment {
  id        Int             @id @default(autoincrement())
  studentId Int             @map("student_id")
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batchId   Int             @map("batch_id")
  batch     Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  joinedOn  DateTime        @map("joined_on") @db.Date
  fee       Decimal         @db.Decimal(12, 2) // after any discount
  status    EnrolmentStatus @default(STUDYING)
  notes     String?         @db.VarChar(255)
  receipts  FeeReceipt[]
  createdBy String          @map("created_by") @db.VarChar(50)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([studentId, batchId])
  @@index([batchId])
  @@map("enrolments")
}

/// Fee received (FEE/2026-27/0001). Cancel only — never edited or deleted.
model FeeReceipt {
  id           Int         @id @default(autoincrement())
  docNo        String      @unique @map("doc_no") @db.VarChar(30)
  enrolmentId  Int         @map("enrolment_id")
  enrolment    Enrolment   @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)
  docDate      DateTime    @map("doc_date") @db.Date
  amount       Decimal     @db.Decimal(12, 2)
  mode         PaymentMode
  reference    String?     @db.VarChar(60)
  notes        String?     @db.VarChar(255)
  status       DocStatus   @default(POSTED)
  createdBy    String      @map("created_by") @db.VarChar(50)
  createdAt    DateTime    @default(now()) @map("created_at")
  cancelledBy  String?     @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?   @map("cancelled_at")
  cancelReason String?     @map("cancel_reason") @db.VarChar(255)

  @@index([enrolmentId])
  @@index([docDate])
  @@map("fee_receipts")
}
