// Brand money: a delivery bill (BD/…) for the pieces handed over, payments from the brand (BRP/…),
// and a register of the brand's own cloth (received / used / given back — not our stock).

enum BrandDocStatus {
  POSTED
  CANCELLED

  @@map("brand_doc_status")
}

/// Bill for pieces delivered to the brand. Rates are GST-inclusive (like customer bills); GST % chosen on the bill.
model BrandBill {
  id           Int            @id @default(autoincrement())
  docNo        String         @unique @map("doc_no") @db.VarChar(30)
  orderId      Int            @map("order_id")
  order        BrandOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  brandId      Int            @map("brand_id")
  brand        PartnerBrand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  brandName    String         @map("brand_name") @db.VarChar(120) // snapshot printed on the bill
  brandGstin   String?        @map("brand_gstin") @db.VarChar(15)
  docDate      DateTime       @map("doc_date") @db.Date
  taxMode      TaxMode        @map("tax_mode")
  gstRate      Decimal        @default(0) @map("gst_rate") @db.Decimal(5, 2)
  grossTotal   Decimal        @default(0) @map("gross_total") @db.Decimal(14, 2) // lines, GST included
  taxableTotal Decimal        @default(0) @map("taxable_total") @db.Decimal(14, 2)
  cgstTotal    Decimal        @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal    Decimal        @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal    Decimal        @default(0) @map("igst_total") @db.Decimal(14, 2)
  roundOff     Decimal        @default(0) @map("round_off") @db.Decimal(6, 2)
  grandTotal   Decimal        @default(0) @map("grand_total") @db.Decimal(14, 2)
  notes        String?        @db.VarChar(500)
  status       BrandDocStatus @default(POSTED)
  createdBy    String         @map("created_by") @db.VarChar(50)
  createdAt    DateTime       @default(now()) @map("created_at")
  cancelledBy  String?        @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?      @map("cancelled_at")
  cancelReason String?        @map("cancel_reason") @db.VarChar(255)

  lines BrandBillLine[]
  items BrandOrderItem[]

  @@index([brandId, docDate])
  @@index([orderId])
  @@index([docDate])
  @@map("brand_bills")
}

/// Printed line: a piece (2 × Blouse · Priya) or an item from our stock charged with it.
model BrandBillLine {
  id          Int       @id @default(autoincrement())
  billId      Int       @map("bill_id")
  bill        BrandBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  kind        String    @db.VarChar(10) // PIECE | ITEM
  description String    @db.VarChar(200)
  endCustomer String?   @map("end_customer") @db.VarChar(120)
  qty         Decimal   @db.Decimal(14, 3)
  unit        String    @default("NOS") @db.VarChar(10)
  rate        Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(14, 2)
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([billId])
  @@map("brand_bill_lines")
}

/// Money received from a brand — reduces what the brand owes (oldest bills first).
model BrandPayment {
  id           Int            @id @default(autoincrement())
  docNo        String         @unique @map("doc_no") @db.VarChar(30)
  brandId      Int            @map("brand_id")
  brand        PartnerBrand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  docDate      DateTime       @map("doc_date") @db.Date
  amount       Decimal        @db.Decimal(14, 2)
  mode         PaymentMode
  reference    String?        @db.VarChar(60)
  notes        String?        @db.VarChar(255)
  status       BrandDocStatus @default(POSTED)
  createdBy    String         @map("created_by") @db.VarChar(50)
  createdAt    DateTime       @default(now()) @map("created_at")
  cancelledBy  String?        @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?      @map("cancelled_at")
  cancelReason String?        @map("cancel_reason") @db.VarChar(255)

  @@index([brandId, docDate])
  @@index([docDate])
  @@map("brand_payments")
}

/// The brand's own cloth for an order: RECEIVED from them, USED for pieces, RETURNED to them. Not our stock.
model BrandClothEntry {
  id          Int          @id @default(autoincrement())
  orderId     Int          @map("order_id")
  order       BrandOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brandId     Int          @map("brand_id")
  brand       PartnerBrand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  date        DateTime     @db.Date
  kind        String       @db.VarChar(10) // RECEIVED | USED | RETURNED
  description String       @db.VarChar(120) // e.g. "Cotton printed"
  qty         Decimal      @db.Decimal(14, 3)
  unit        String       @default("m") @db.VarChar(10)
  notes       String?      @db.VarChar(255)
  createdBy   String       @map("created_by") @db.VarChar(50)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([orderId])
  @@index([brandId])
  @@map("brand_cloth_entries")
}
