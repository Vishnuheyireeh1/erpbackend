// Sales: customers, sales bills (stock OUT), money received (receipts), sales returns (stock back IN).
// Selling prices are GST-INCLUSIVE; GST is worked out backwards for the breakup.
// Documents are never edited or deleted — cancelled with a reason.

model Customer {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(20) // C0001
  name           String   @db.VarChar(120)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(120)
  gstin          String?  @db.VarChar(15) // business customers (B2B bills)
  stateCode      String   @default("32") @map("state_code") @db.VarChar(2)
  address        String?  @db.VarChar(255)
  city           String?  @db.VarChar(60)
  pincode        String?  @db.VarChar(6)
  /// What they already owed the shop on go-live (+ = they owe us).
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  notes          String?  @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sales        SalesInvoice[]
  receipts     CustomerReceipt[]
  returns      SalesReturn[]
  measurements CustomerMeasurement[]
  jobs         StitchingJob[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

/// Sales bill (SDB/2026-27/0001). customerId null = walk-in (must be paid in full).
model SalesInvoice {
  id             Int                 @id @default(autoincrement())
  docNo          String              @unique @map("doc_no") @db.VarChar(30)
  customerId     Int?                @map("customer_id")
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Snapshot printed on the bill (stays correct even if the customer is edited later).
  customerName   String              @map("customer_name") @db.VarChar(120)
  customerPhone  String?             @map("customer_phone") @db.VarChar(20)
  customerGstin  String?             @map("customer_gstin") @db.VarChar(15)
  docDate        DateTime            @map("doc_date") @db.Date
  bookNo         String?             @map("book_no") @db.VarChar(30) // number from the paper bill book (optional)
  status         DocStatus           @default(POSTED)
  taxMode        TaxMode             @map("tax_mode")
  grossTotal     Decimal             @map("gross_total") @db.Decimal(14, 2) // before discounts
  discountTotal  Decimal             @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxableTotal   Decimal             @map("taxable_total") @db.Decimal(14, 2)
  cgstTotal      Decimal             @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal      Decimal             @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal      Decimal             @default(0) @map("igst_total") @db.Decimal(14, 2)
  roundOff       Decimal             @default(0) @map("round_off") @db.Decimal(6, 2)
  grandTotal     Decimal             @map("grand_total") @db.Decimal(14, 2)
  paidAmount     Decimal             @default(0) @map("paid_amount") @db.Decimal(14, 2) // from receipt allocations
  returnedAmount Decimal             @default(0) @map("returned_amount") @db.Decimal(14, 2)
  cashTendered   Decimal             @default(0) @map("cash_tendered") @db.Decimal(14, 2) // printed: cash given / change
  changeReturned Decimal             @default(0) @map("change_returned") @db.Decimal(14, 2)
  costTotal      Decimal             @default(0) @map("cost_total") @db.Decimal(14, 2) // stock cost (for profit)
  notes          String?             @db.VarChar(500)
  lines          SalesLine[]
  allocations    ReceiptAllocation[]
  credits        CreditAllocation[]
  returns        SalesReturn[]
  createdBy      String              @map("created_by") @db.VarChar(50)
  createdAt      DateTime            @default(now()) @map("created_at")
  cancelledBy    String?             @map("cancelled_by") @db.VarChar(50)
  cancelledAt    DateTime?           @map("cancelled_at")
  cancelReason   String?             @map("cancel_reason") @db.VarChar(255)

  @@index([bookNo])
  @@index([docDate])
  @@index([customerId])
  @@index([status])
  @@map("sales_invoices")
}

model SalesLine {
  id          Int            @id @default(autoincrement())
  invoiceId   Int            @map("invoice_id")
  invoice     SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  variantId   Int            @map("variant_id")
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  description String         @db.VarChar(200) // "Anarkali kurti · M · Red" at the time of sale
  hsnCode     String?        @map("hsn_code") @db.VarChar(8)
  qty         Decimal        @db.Decimal(14, 3)
  rate        Decimal        @db.Decimal(12, 2) // per unit, GST included
  discountPct Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  amount      Decimal        @db.Decimal(14, 2) // after line + bill discount, GST included
  gstRate     Decimal        @map("gst_rate") @db.Decimal(5, 2)
  taxable     Decimal        @db.Decimal(14, 2)
  cgst        Decimal        @default(0) @db.Decimal(14, 2)
  sgst        Decimal        @default(0) @db.Decimal(14, 2)
  igst        Decimal        @default(0) @db.Decimal(14, 2)
  unitCost    Decimal        @default(0) @map("unit_cost") @db.Decimal(14, 4) // average cost when sold
  returnedQty Decimal        @default(0) @map("returned_qty") @db.Decimal(14, 3)

  @@index([invoiceId])
  @@index([variantId])
  @@map("sales_lines")
}

/// Money received from a customer (RCP/2026-27/0001). One receipt can mix cash + UPI + card.
model CustomerReceipt {
  id           Int                 @id @default(autoincrement())
  docNo        String              @unique @map("doc_no") @db.VarChar(30)
  customerId   Int?                @map("customer_id")
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  docDate      DateTime            @map("doc_date") @db.Date
  amount       Decimal             @db.Decimal(14, 2)
  notes        String?             @db.VarChar(255)
  status       DocStatus           @default(POSTED)
  tenders      ReceiptTender[]
  allocations  ReceiptAllocation[]
  createdBy    String              @map("created_by") @db.VarChar(50)
  createdAt    DateTime            @default(now()) @map("created_at")
  cancelledBy  String?             @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?           @map("cancelled_at")
  cancelReason String?             @map("cancel_reason") @db.VarChar(255)

  @@index([customerId, docDate])
  @@index([docDate])
  @@map("customer_receipts")
}

/// How the money came in (for the day book: cash in hand vs UPI vs card).
model ReceiptTender {
  id        Int             @id @default(autoincrement())
  receiptId Int             @map("receipt_id")
  receipt   CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  mode      PaymentMode
  amount    Decimal         @db.Decimal(14, 2)
  reference String?         @db.VarChar(60)

  @@index([receiptId])
  @@map("receipt_tenders")
}

model ReceiptAllocation {
  id        Int             @id @default(autoincrement())
  receiptId Int             @map("receipt_id")
  receipt   CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  // Exactly one of invoiceId / jobId is set (check constraint in the migration).
  invoiceId Int?            @map("invoice_id")
  invoice   SalesInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  jobId     Int?            @map("job_id")
  job       StitchingJob?   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(14, 2)

  @@index([receiptId])
  @@index([invoiceId])
  @@index([jobId])
  @@map("receipt_allocations")
}

/// Goods returned by a customer (SR/2026-27/0001) — stock back IN at the cost it went out at.
model SalesReturn {
  id           Int                @id @default(autoincrement())
  docNo        String             @unique @map("doc_no") @db.VarChar(30)
  customerId   Int?               @map("customer_id")
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Against a counter bill (invoiceId) OR items sold on a stitching job (jobId) — exactly one (DB check).
  invoiceId    Int?               @map("invoice_id")
  invoice      SalesInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  jobId        Int?               @map("job_id")
  job          StitchingJob?      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  docDate      DateTime           @map("doc_date") @db.Date
  reason       String             @db.VarChar(255)
  taxableTotal Decimal            @map("taxable_total") @db.Decimal(14, 2)
  taxTotal     Decimal            @map("tax_total") @db.Decimal(14, 2)
  grandTotal   Decimal            @map("grand_total") @db.Decimal(14, 2)
  refundMode   PaymentMode?       @map("refund_mode") // null = kept as credit for the customer
  refundAmount Decimal            @default(0) @map("refund_amount") @db.Decimal(14, 2)
  /// Part of the value that cleared the balance of its own bill.
  billCleared  Decimal            @default(0) @map("bill_cleared") @db.Decimal(14, 2)
  /// Credit = grandTotal − refundAmount − billCleared; creditUsed = how much of it later bills / jobs took.
  creditUsed   Decimal            @default(0) @map("credit_used") @db.Decimal(14, 2)
  credits      CreditAllocation[]
  status       DocStatus          @default(POSTED)
  lines        SalesReturnLine[]
  createdBy    String             @map("created_by") @db.VarChar(50)
  createdAt    DateTime           @default(now()) @map("created_at")
  cancelledBy  String?            @map("cancelled_by") @db.VarChar(50)
  cancelledAt  DateTime?          @map("cancelled_at")
  cancelReason String?            @map("cancel_reason") @db.VarChar(255)

  @@index([docDate])
  @@map("sales_returns")
}

model SalesReturnLine {
  id            Int          @id @default(autoincrement())
  returnId      Int          @map("return_id")
  return        SalesReturn  @relation(fields: [returnId], references: [id], onDelete: Restrict)
  salesLineId   Int?         @map("sales_line_id")
  jobMaterialId Int?         @map("job_material_id")
  jobMaterial   JobMaterial? @relation(fields: [jobMaterialId], references: [id], onDelete: Restrict)
  variantId     Int          @map("variant_id")
  qty           Decimal      @db.Decimal(14, 3)
  taxable       Decimal      @db.Decimal(14, 2)
  tax           Decimal      @db.Decimal(14, 2)
  total         Decimal      @db.Decimal(14, 2)
  unitCost      Decimal      @map("unit_cost") @db.Decimal(14, 4)

  @@index([returnId])
  @@map("sales_return_lines")
}
