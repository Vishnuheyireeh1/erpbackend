# Server
NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5174
# true only when the ERP is opened over https (leave false on the shop's own Wi-Fi)
COOKIE_SECURE=false
# Hosted behind a proxy (e.g. Render): 1. Leave empty on the shop PC.
TRUST_PROXY=
# Built screens served by this server in production (npm run build in frontend first)
CLIENT_DIST=../frontend/dist

# Backups (pg_dump). Daily automatic backup into BACKUP_DIR; optional copy to a 2nd folder (pen drive / OneDrive).
BACKUP_DIR=backups
BACKUP_COPY_DIR=
BACKUP_KEEP=30
# Folder that has pg_dump.exe — found automatically under C:Program FilesPostgreSQL<version>in
PG_BIN=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sairandhri_erp
DB_USER=postgres
DB_PASSWORD=change_me

# Auth — use a long random string (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# First admin account (used only by: npm run db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
